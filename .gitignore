.venv/
__pycache__/
.pytest_cache/
artifacts/
.DS_Store

.local/

# Credentials and local configuration (also catches malformed .env filenames).
.env*
!.env.example
.streamlit/*
!.streamlit/config.toml
*credentials*
*.pem
*.key
.aws/

# Local execution and editor artifacts. Approved demo snapshots live in demo_results/.
*.log
*.tmp
*.swp
~$*
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Original local design screenshots; not needed by the application or tests.
/references/

# Approved, hash-pinned snapshots override developer-global archive ignores.
!/demo_results/*.json.gz

# Owner-supplied visual references remain local.
/resources/references/Portfolio_GP_Rollup_UI_References/
